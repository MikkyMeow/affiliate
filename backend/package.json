    "express": "^4.19.2",
    "express-rate-limit": "^8.3.1",
    "geoip-lite": "^2.0.1",
    "jsonwebtoken": "^9.0.2",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.20.0",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^4.3.1",
    "redis": "^5.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.3",
    "supertest": "^7.2.2",
    "vitest": "^4.1.0"
