PORT=4000

# Database connection for local development
DB_HOST=localhost
DB_PORT=6543
DB_NAME=affiliate
DB_USER=affiliate
DB_PASSWORD=affiliate

# Optional single URL form (overrides the discrete vars above)
DATABASE_URL=postgres://affiliate:affiliate@localhost:6543/affiliate

# Redis (optional overrides; defaults shown)
REDIS_HOST=127.0.0.1
REDIS_PORT=7379
# Set to false only if Redis is optional in this environment
REDIS_REQUIRED=true
# REDIS_USERNAME=default
# REDIS_PASSWORD=

# Async jobs / BullMQ
QUEUE_NAME=postback-events
ASYNC_JOBS_QUEUE=postback-events
ASYNC_WORKER_CONCURRENCY=5
ASYNC_JOB_ATTEMPTS=3
ASYNC_JOB_BACKOFF_DELAY_MS=1000
ASYNC_JOB_HISTORY=1000
ASYNC_JOB_REMOVE_ON_FAIL=200
BULLMQ_PREFIX=affiliate

# Authentication
JWT_SECRET=change-me
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_TTL_DAYS=7
